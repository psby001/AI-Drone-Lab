{
  "name": "ai-drone-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:https": "tsx scripts/dev.ts --https",
    "dev:http": "tsx scripts/dev.ts --http",
    "dev:client": "vite --host 0.0.0.0 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "build": "tsx scripts/export-dronekit.ts && tsx scripts/export-missions.ts && tsx scripts/export-challenges.ts && tsc --noEmit && vite build",
    "dronekit:template": "tsx scripts/export-dronekit.ts",
    "dronekit:verify": "tsx scripts/export-dronekit.ts && tsx scripts/verify-dronekit.ts && tsx scripts/export-dronekit.ts",
    "test": "tsx --test tests/*.test.ts",
    "check:upload": "tsx scripts/check-upload.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "blockly": "^13.4.0",
    "jose": "^6.2.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
